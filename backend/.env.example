# Backend runtime config. Copy to .env and fill in.

# Supabase — used as Postgres only, service role (never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string (for running migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (Upstash or Railway). Cache / queues / flow-state / rate-limit only.
REDIS_URL=redis://localhost:6379

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
# Bot username (without @) — used to build invite deep links t.me/<username>?start=<token>
BOT_USERNAME=
# Public HTTPS URL of the deployed WebApp (Mini App), e.g. https://app.example.com
WEBAPP_URL=

# Bootstrap the first MEGA_ADMIN: set to your Telegram numeric id, then send /start
# to the bot once. Creates the root admin only if no MEGA_ADMIN exists yet.
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# App
PORT=3000
NODE_ENV=development

# Domain tunables (see PRODUCT_LOGIC.md)
ACTIVE_WORK_LIMIT=5
WORK_CHECK_DAYS=7
WORK_EXPIRY_DAYS=14
